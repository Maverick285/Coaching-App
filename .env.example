# --- API keys --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- Auth ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
BUDDY_AUTH_TOKEN=replace-me-with-a-long-random-token

# --- Storage ---------------------------------------------------------------
BUDDY_DB_PATH=/data/buddy.db
BUDDY_MEMORY_PATH=/data/memory

# --- User --------------------------------------------------------------------
BUDDY_USER_NAME=Maverick
BUDDY_PERSONA_NAME=Coach

# --- Behavior --------------------------------------------------------------
BUDDY_LOG_LEVEL=INFO
BUDDY_TIMEZONE=America/Chicago
BUDDY_CONSOLIDATION_HOUR=3

# Daily rhythm anchors (server-local). The Android app schedules its own
# alarms; these drive the server-side grade pre-compute and are exposed
# via /health for clients to read.
BUDDY_MORNING_HOUR=7
BUDDY_MORNING_MINUTE=0
BUDDY_EOD_HOUR=21
BUDDY_EOD_MINUTE=0

# --- LLM tier resolution (optional pins; leave blank for current-latest) ---
BUDDY_FAST_MODEL_PIN=
BUDDY_REASONING_MODEL_PIN=
BUDDY_EMBEDDING_MODEL=text-embedding-3-small

# --- Budget envelope (USD, monthly) ----------------------------------------
BUDDY_BUDGET_SOFT_USD=50
BUDDY_BUDGET_HARD_USD=100

# --- Memory git remote (private) -------------------------------------------
BUDDY_GIT_REMOTE=

# --- Notifications ---------------------------------------------------------
BUDDY_DREAMS_NOTIFICATION_EMAIL=

# --- Phase 5: override system ----------------------------------------------
# When you (mid-task you) ask to override a Tier 3/4 block, the backend
# texts a one-time code to the approver (typically your spouse or a
# trusted friend). Without these set, the system runs in "log only" mode
# — the code is echoed back in the API response and printed to logs, so
# you can develop locally before wiring SMS. For real use, fill all four:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15555550100
BUDDY_OVERRIDE_APPROVER_NUMBER=+15555550199
BUDDY_OVERRIDE_APPROVER_LABEL=Wife
